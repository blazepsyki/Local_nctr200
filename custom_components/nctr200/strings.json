{
  "config": {
    "step": {
      "user": {
        "title": "NCTR-200 local server",
        "description": "Home Assistant starts listening for the controller once you submit. The controller does not need to be connected yet.\n\nNext, point the controller's Wi-Fi settings at this server: server `{server}`, port {port}. Use **Configure → Provision the controller** on this integration, or the standalone provision.py tool from a PC. See the README.",
        "data": {
          "allowed_client": "Allowed client (optional)",
          "port": "Port",
          "host": "Listen address"
        },
        "data_description": {
          "allowed_client": "Accept connections only from this IP or network. Filled with Home Assistant's LAN; leave empty to accept any. Behind a Windows hotspot the controller appears as the PC's address.",
          "port": "TCP port the controller connects to (20000 by default).",
          "host": "0.0.0.0 listens on every interface."
        }
      }
    },
    "error": {
      "invalid_client": "Enter an IP address or a network such as 192.168.1.0/24.",
      "invalid_host": "Enter an IPv4 address.",
      "port_in_use": "This port is in use by another program. Stop it first."
    },
    "abort": {
      "single_instance_allowed": "Only one NCTR-200 controller is supported."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "NCTR-200",
        "menu_options": {
          "settings": "Server settings",
          "provision": "Provision the controller"
        }
      },
      "settings": {
        "title": "Server settings",
        "data": {
          "allowed_client": "Allowed client (optional)",
          "port": "Port",
          "host": "Listen address"
        },
        "data_description": {
          "allowed_client": "Accept connections only from this IP or network. Filled with Home Assistant's LAN; leave empty to accept any. Behind a Windows hotspot the controller appears as the PC's address.",
          "port": "TCP port the controller connects to (20000 by default).",
          "host": "0.0.0.0 listens on every interface."
        }
      },
      "provision": {
        "title": "Provision the controller",
        "description": "Sends the Wi-Fi settings to the controller once. Before submitting:\n1. Put the controller in setup mode (power off, hold the Away button for 5 seconds). It opens the `{setup_ssid}` Wi-Fi.\n2. Connect this Home Assistant host to `{setup_ssid}`. The host needs a Wi-Fi adapter besides its LAN link.\n\nThe controller will connect to `{server}`, port {port}. It needs Internet access to look up that name. The password is used once and not stored.",
        "data": {
          "ssid": "Wi-Fi name (2.4 GHz)",
          "password": "Wi-Fi password",
          "server_ip": "Server IP"
        },
        "data_description": {
          "ssid": "The network the controller should join.",
          "server_ip": "Home Assistant's address on that network."
        }
      }
    },
    "error": {
      "invalid_client": "Enter an IP address or a network such as 192.168.1.0/24.",
      "invalid_host": "Enter an IPv4 address.",
      "port_in_use": "This port is in use by another program. Stop it first.",
      "invalid_provision": "The Wi-Fi name and password must be printable ASCII without commas, and the server must be an IPv4 address.",
      "not_on_setup_ap": "This Home Assistant host has no address in 192.168.200.0/24. Connect it to the controller's krb_set network and give that Wi-Fi adapter the fixed address 192.168.200.2/24; the controller hands out no address.",
      "provision_failed": "Could not send to the controller.",
      "provision_rejected": "The controller rejected the settings."
    },
    "abort": {
      "provision_sent": "Sent. The `krb_set` network should disappear within seconds; the controller then joins the Wi-Fi and connects to `{server}`, port {port}. Watch the Connection entity."
    }
  },
